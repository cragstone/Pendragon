  <section >
    <div class = "wound-item-grid">
      <div class="stat-name left bold">{{localize 'PEN.damage'}}</div>
      <div class="stat-name-input left bottom dam-value"><input name="system.value" type="number" value="{{item.system.value}}"/></div>
      <div class="stat-name left bold">{{localize 'PEN.damType'}}</div>
      <div class="stat-name">{{source}}</div>
      <div class="stat-name left bold">{{localize 'PEN.description'}}</div>
      <div class="stat-name-input {{#if (eq system.description '')}} input-border {{/if}}"><input name="system.description" type="text" value="{{item.system.description}}"/></div>
    </div>
  </section>
