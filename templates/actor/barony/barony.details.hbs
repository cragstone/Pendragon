<section class="tab details {{tab.cssClass}} droppable" data-collection = "enfeoffed" data-group="primary" data-tab="details">
  <br>
  <div class="barony-improv-grid droppable">
    <div class="stat-name left indent new-row">{{localize 'PEN.manor.county'}}</div>
    <div class="stat-name-input  centre"><input name="system.county" type="text" value="{{system.county}}"/></div>  
    <div class="stat-name left indent new-row">{{localize 'PEN.manor.leige'}}</div>
    <div class="stat-name-input  centre"><input name="system.leige" type="text" value="{{system.leige}}"/></div>      


    <div class="stat-name left indent new-row">{{localize 'PEN.manor.yearAssized'}}</div>
    <div class="stat-name-input  centre"><input name="system.yearAssized" type="number" value="{{system.yearAssized}}"/></div>     
    <div class="stat-name left indent new-row">{{localize 'PEN.manor.rent'}}{{localize 'PEN.manor.l'}}</div>
    <div class="stat-name-input"><input class="centre" name="system.rent.libra" type="number" value="{{system.rent.libra}}"/></div>    
    
    <div class="stat-name left indent new-row">{{localize 'PEN.manor.sol'}}</div>
    <div class="stat-name left indent new-row" style="padding-left:20px;">{{localize 'PEN.manor.solExpect'}}</div>
    <div class="stat-name centre">{{system.solCalc.libra}}</div>    
    <div class="stat-name left indent new-row" style="padding-left:20px;">{{localize 'PEN.manor.solActual'}}</div>
    <div class="stat-name-input"><input class="centre" name="system.sol.libra" type="number" value="{{system.sol.libra}}"/></div>    
    {{#unless system.solMet}}
      <div class="stat-name left indent" data-tooltip="{{localize 'PEN.manor.belowSol'}}">
        <a class="darkred"><i class="fas fa-circle-exclamation"></i></a>
      </div>
    {{else}}
      <div></div>  
    {{/unless}} 
    <div class="stat-name left indent new-row">{{localize 'PEN.manor.armyCost'}}{{localize 'PEN.manor.l'}}</div>
    <div class="stat-name centre">{{system.armyCost.libra}}</div>    
    <div class="stat-name left indent new-row">{{localize 'PEN.manor.expenses'}}</div>
    <div class="stat-name centre">{{system.cost.libra}}</div>    
    <div class="stat-name left indent new-row">{{localize 'PEN.manor.folkCost'}}{{localize 'PEN.manor.l'}}</div>
    <div class="stat-name centre">{{system.folkCost.libra}}</div>    
    <div class="stat-name left bold indent new-row">{{localize 'PEN.manor.privyInc'}}{{localize 'PEN.manor.l'}}</div>
    <div class="stat-name bold centre">{{system.privyInc.libra}}</div>    
 
    <div class="new-row">&nbsp</div>

    <div class="stat-name left indent new-row bold">{{localize 'PEN.manor.caput'}}:</div>
    <div class="stat-name-input centre">
      <input class="centre" name="system.caput" type="text" value="{{system.caput}}"/>
    </div>  
    <div class="stat-name" data-tooltip="{{actor.dvLabelHint}}">{{localize 'PEN.manor.dvAbbr'}}: {{actor.dvLabel}}</div>

    <div class="new-row">&nbsp</div>

    <div class="horizontalboxed new-row">
      <div class="stat-name left indent bold">{{localize 'PEN.manor.enfeoffed'}}</div>
      <div class="stat-name left indent">{{localize 'PEN.manor.stewardship'}}: {{system.enfeoffed.stewardship}}</div>
      </div>
      <div class="horizontalboxed">
        {{#unless showOption}}
          <div class="stat-name centre {{#unless system.enfeoffed.npc}}italics{{/unless}}">{{enfeoffedLabel}}
            {{#if actor.system.enfeoffed.npc}}
              <span>
                <a class="item-control medium-icon fade" data-action="viewEnf"><i data-tooltip="{{localize 'PEN.view'}}" class="fa-solid fa-eye"></i></a>
                <a class="item-control  medium-icon fade" data-action="deleteEnf"><i data-tooltip="{{localize 'PEN.delete'}}" class="fa-solid fa-broom-wide"></i></a>
              <span>          
            {{/if}}  
          </div>    
        {{else}}      
          <div class="stat-name">
            <select class="centre" data-handle-change name="system.enfeoffed.background">
              {{selectOptions folkList selected=actor.system.enfeoffed.background}}
            </select>
          </div>
        {{/unless}}
    </div>


  </div>
</section>