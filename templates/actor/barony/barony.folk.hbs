<section class='character tab folk {{tab.cssClass}}' data-group='primary' data-tab='folk'>
  <div class="droppable" data-collection = "npcs">
    <table>
        <tbody>
          <tr>
              <th>{{localize 'PEN.manor.folk'}}</th>
              <th class="centre">{{localize 'PEN.type'}}</th>
              <th class="centre">{{localize 'PEN.manor.costShort'}}</th>
              <th class="centre">&nbsp</th>              
          </tr>
          {{#each folks as |folk key|}}
          <tr data-itemid = "{{folk.id}}">
            <td>{{folk.name}}</td>
            <td class="centre">{{folk.typeLabel}}</td>
            <td class="centre">{{folk.system.totalCost.libra}} / {{folk.system.totalCost.denarii}}</td>
            <td>
                <a class="item-control medium-icon fade" data-action="viewDoc"><i data-tooltip="{{localize 'PEN.view'}}" class="fa-solid fa-eye"></i></a>
                <a class="item-control  medium-icon fade" data-action="deleteDoc"><i data-tooltip="{{localize 'PEN.delete'}}" class="fa-solid fa-broom-wide"></i></a>
            </td>
          </tr>
          {{else}}
          <tr>
            <td class="centre italics" colspan="4">{{localize 'PEN.emptyList'}}</td>
          </tr>

          {{/each}}
        </tbody>
    </table>
  </div>

</section>