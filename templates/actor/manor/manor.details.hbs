<section class="tab details {{tab.cssClass}} droppable" data-collection = "enfeoffed" data-group="primary" data-tab="details">
  <br>
  <div class="item-improv-grid droppable">
    <div class="stat-name left indent new-row">{{localize 'PEN.manor.yearAssized'}}</div>
    <div class="stat-name-input  centre"><input name="system.yearAssized" type="number" value="{{system.yearAssized}}"/></div>     
    <div class="stat-name left indent new-row">{{localize 'PEN.manor.rent'}}{{localize 'PEN.manor.ld'}}</div>
    <div class="cost-grid">
      <div class="stat-name-input"><input class="centre" name="system.rent.libra" type="number" value="{{system.rent.libra}}"/></div>    
      <div class="stat-name centre">/</div>
      <div class="stat-name-input  centre"><input class="centre" name="system.rent.denarii" type="number" value="{{system.rent.denarii}}"/></div>      
    </div> 
    <div class="stat-name left indent new-row">{{localize 'PEN.manor.currVal'}}{{localize 'PEN.manor.ld'}}</div>
    <div class="cost-grid">
      <div class="stat-name centre">{{system.currVal.libra}}</div>    
      <div class="stat-name centre">/</div>
      <div class="stat-name centre">{{system.currVal.denarii}}</div>      
    </div> 
    <div class="stat-name left indent new-row">{{localize 'PEN.manor.income'}}{{localize 'PEN.manor.ld'}}</div>
    <div class="cost-grid">
      <div class="stat-name centre">{{system.income.libra}}</div>    
      <div class="stat-name centre">/</div>
      <div class="stat-name centre">{{system.income.denarii}}</div>      
    </div>  
    <div class="stat-name left indent new-row">{{localize 'PEN.manor.annualCost'}}{{localize 'PEN.manor.ld'}}</div>
    <div class="cost-grid">
      <div class="stat-name centre">{{system.cost.libra}}</div>    
      <div class="stat-name centre">/</div>
      <div class="stat-name centre">{{system.cost.denarii}}</div>      
    </div>                   
    <div class="stat-name left indent new-row">{{localize 'PEN.manor.armyCost'}}{{localize 'PEN.manor.ld'}}</div>
    <div class="cost-grid">
      <div class="stat-name centre">{{system.armyCost.libra}}</div>    
      <div class="stat-name centre">/</div>
      <div class="stat-name centre">{{system.armyCost.denarii}}</div>      
    </div>  
    <div class="stat-name left indent new-row">{{localize 'PEN.manor.folkCost'}}{{localize 'PEN.manor.ld'}}</div>
    <div class="cost-grid">
      <div class="stat-name centre">{{system.folkCost.libra}}</div>    
      <div class="stat-name centre">/</div>
      <div class="stat-name centre">{{system.folkCost.denarii}}</div>      
    </div>                           
    <div class="stat-name bold left indent new-row">{{localize 'PEN.manor.privyInc'}}{{localize 'PEN.manor.ld'}}</div>
    <div class="cost-grid">
      <div class="stat-name bold centre">{{system.privyInc.libra}}</div>    
      <div class="stat-name bold centre">/</div>
      <div class="stat-name bold centre">{{system.privyInc.denarii}}</div>      
    </div>                       
    <br>    
    <div class="stat-name left indent new-row bold">{{localize 'PEN.dv.title'}}:</div>
    <div class="stat-name-input centre" data-tooltip="{{actor.dvLabelHint}}">{{actor.dvLabel}}</div>    
    <br>


    <div class="horizontalboxed new-row">

    <div class="stat-name left indent bold">{{localize 'PEN.manor.enfeoffed'}}</div>
    <div class="stat-name left indent">{{localize 'PEN.manor.stewardship'}}: {{system.enfeoffed.stewardship}}</div>
    </div>
    <div class="horizontalboxed">
      {{#unless showOption}}
        <div class="stat-name centre {{#unless system.enfeoffed.npc}}italics{{/unless}}">{{enfeoffedLabel}}
          {{#if actor.system.enfeoffed.npc}}
            <span>
              <a class="item-control medium-icon fade" data-action="viewEnf"><i data-tooltip="{{localize 'PEN.view'}}" class="fa-solid fa-eye"></i></a>
              <a class="item-control  medium-icon fade" data-action="deleteEnf"><i data-tooltip="{{localize 'PEN.delete'}}" class="fa-solid fa-broom-wide"></i></a>
            <span>          
          {{/if}}  
        </div>    
      {{else}}      
        <div class="stat-name">
          <select class="centre" data-handle-change name="system.enfeoffed.background">
            {{selectOptions folkList selected=actor.system.enfeoffed.background}}
          </select>
        </div>
      {{/unless}}
    </div>
  </div>  
</section>