<section class='character tab skills {{tab.cssClass}}' data-group='primary' data-tab='skills'>
  <div class="droppable">
    <table>
        <tbody>
          <tr>
              <th style="min-width: 150px">{{localize 'TYPES.Item.skill'}}</th>
              <th class="centre">{{localize 'PEN.from'}}</th>
              <th class="centre">{{localize 'PEN.value'}}</th>
              <th class="centre">{{localize 'PEN.xp'}}</th>              
              <th class="centre">&nbsp</th>              
          </tr>
          {{#each skills as |skill key|}}
          <tr data-itemid = "{{skill.id}}">
            <td class="rollable skill-name" data-itemid="{{skill.id}}">{{skill.name}}</td>
            <td class="centre">{{skill.sourceLabel}}</td>
            <td class="centre">{{skill.system.total}}</td>
            <td class="centre">
              <a class="item-control large-icon" data-action="itemToggle" data-property="XP">
                <i class="{{#if skill.system.XP}}fa-regular fa-square-check{{else}}fa-regular fa-square{{/if}}"></i>
              </a>
            </td>            
            <td>
                <a class="item-control medium-icon fade" data-action="viewDoc"><i data-tooltip="{{localize 'PEN.view'}}" class="fa-solid fa-eye"></i></a>
                <a class="item-control  medium-icon fade" data-action="deleteDoc"><i data-tooltip="{{localize 'PEN.delete'}}" class="fa-solid fa-broom-wide"></i></a>
            </td>
          </tr>
          {{else}}
          <tr>
            <td class="centre italics" colspan="5">{{localize 'PEN.emptyList'}}</td>
          </tr>

          {{/each}}
        </tbody>
    </table>
  </div>

</section>