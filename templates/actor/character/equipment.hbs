<section class="tab equipment {{tab.cssClass}}" data-group="primary" data-tab="equipment">
    <h2>{{localize 'PEN.wield.label'}}</h2>
    <table>
        <tbody>
          <tr>
              <th>{{localize 'PEN.wield.primaryHand'}}</th>
              <th>{{localize 'PEN.secondaryHand'}}</th>
              <th>{{localize 'PEN.ap'}}</th>
              <th></th>
          </tr>
          <tr>
            <td data-hand="primary">
              {{#if (eq system.equippedHands.primary system.equippedHands.secondary)}}
                {{#if primaryHandItem}}{{primaryHandItem.name}} <em>({{localize 'PEN.wield.twoHanded'}})</em>{{/if}}
              {{else}}
                {{#if primaryHandItem}}{{primaryHandItem.name}}{{/if}}
              {{/if}}
              {{#if primaryHandItem}}
                &nbsp <a class="item-control large-icon" data-action="dropHeldItem" data-tooltip="{{localize 'PEN.wield.dropHint'}}"><i class="fas fa-arrow-down-from-line"></i></a>
              {{/if}}
            </td>
            <td data-hand="secondary">
              {{#if (eq system.equippedHands.primary system.equippedHands.secondary)}}
                {{!-- two-handed grip: the same weapon, muted, shows both hands are occupied --}}
                {{#if secondaryHandItem}}
                  <span class="two-handed-grip"><i class="fa-solid fa-link"></i> {{secondaryHandItem.name}}</span>
                {{/if}}
              {{else}}
                {{#if secondaryHandItem}}{{secondaryHandItem.name}}{{/if}}
                {{#if secondaryHandItem}}
                  &nbsp <a class="item-control large-icon" data-action="dropHeldItem" data-tooltip="{{localize 'PEN.wield.dropHint'}}"><i class="fas fa-arrow-down-from-line"></i></a>
                {{/if}}
              {{/if}}
            </td>
            <td>{{system.shield}}</td>
            <td></td>
          </tr>
        </tbody>
    </table>

    <h2>{{localize 'PEN.armour'}}</h2>
    <table>
        <tbody>
          <tr>
              <th>{{localize 'PEN.armour'}}</th>
              <th>{{localize 'PEN.available'}}</th>
              <th>{{localize 'PEN.ap'}}</th>
              <th>{{localize 'PEN.material'}}</th>
              <th>{{localize 'PEN.padding'}}</th>
              <th>{{localize 'PEN.eqpd'}}</th>
          </tr>
          {{#each armours as |armour key|}}
          <tr data-itemid ="{{armour._id}}">
            <td>{{armour.name}}</td>
            <td>{{localize 'PEN.period.all'}}</td>
            <td>{{armour.system.ap}}</td>
            <td>{{armour.materialLabel}}</td>
            <td>{{armour.system.padding}}</td>
            <td><a class="item-control large-icon" data-action="toggleEquip"><i class="{{#if armour.system.equipped}}fa-regular fa-square-check{{else}}fa-regular fa-square{{/if}}"></i></a></td>
          </tr>
          {{/each}}
        </tbody>
    </table>

    <h2>{{localize 'PEN.weapons'}}</h2>
    <table>
        <tbody>
          <tr>
              <th>{{localize 'PEN.weapon'}}</th>
              <th>{{localize 'PEN.quantityShort'}}</th>
              <th>{{localize 'PEN.available'}}</th>
              <th>{{localize 'PEN.footvMount'}}</th>
              <th>{{localize 'PEN.skill'}}</th>
              <th>{{localize 'PEN.value'}}</th>
              <th>{{localize 'PEN.parry'}}</th>
              <th>{{localize 'PEN.damage'}}</th>
              <th>{{localize 'PEN.wield.label'}}</th>
          </tr>
          {{#each weapons as |weapon key|}}
          {{#if weapon.system.melee}}
          <tr data-itemid="{{weapon._id}}" {{#if weapon.wielded}}class="wielded"{{/if}}>
            <td>{{weapon.name}}</td>
            <td>{{weapon.system.quantity}}</td>
            <td>{{localize 'PEN.period.all'}}</td>
            <td>{{weapon.mountedLabel}}</td>
            <td>{{weapon.system.skillName}}</td>
            <td>{{weapon.system.total}}</td>
            <td>{{weapon.system.parry}}</td>
            <td>{{weapon.system.damage}}</td>
            <td>
              <div class="wield-stances">
                {{#each weapon.stances as |stance|}}
                <button type="button" class="stance-btn{{#if stance.active}} active{{/if}}" data-action="wieldStance" data-wield="{{stance.key}}" data-tooltip="{{#if stance.active}}{{localize 'PEN.wield.stowHint'}}{{else}}{{stance.label}}{{/if}}">{{stance.label}}</button>
                {{/each}}
              </div>
            </td>
          </tr>
          {{/if}}
          {{/each}}
        </tbody>
    </table>
    <table>
        <tbody>
          <tr>
              <th>{{localize 'PEN.weapon'}}</th>
              <th>{{localize 'PEN.quantityShort'}}</th>
              <th>{{localize 'PEN.available'}}</th>
              <th>{{localize 'PEN.footvMount'}}</th>
              <th>{{localize 'PEN.skill'}}</th>
              <th>{{localize 'PEN.value'}}</th>
              <th>{{localize 'PEN.range'}}</th>
              <th>{{localize 'PEN.damage'}}</th>
          </tr>
          {{#each weapons as |weapon key|}}
          {{#unless weapon.system.melee}}
          <tr {{#if weapon.wielded}}class="wielded"{{/if}}>
            <td>{{weapon.name}}</td>
            <td>{{weapon.system.quantity}}</td>
            <td>{{localize 'PEN.period.all'}}</td>
            <td>{{weapon.system.mounted}}</td>
            <td>{{weapon.system.skillName}}</td>
            <td>{{weapon.system.total}}</td>
            <td>{{weapon.system.range}}</td>
            <td>{{weapon.system.damage}}</td>
          </tr>
          {{/unless}}
          {{/each}}
        </tbody>
    </table>

    {{#if droppedWeapons.length}}
    <h2>{{localize 'PEN.wield.dropped'}}</h2>
    <table>
        <tbody>
          <tr>
              <th>{{localize 'PEN.weapon'}}</th>
              <th>{{localize 'PEN.quantityShort'}}</th>
              <th>{{localize 'PEN.wield.pickUp'}}</th>
              <th>{{localize 'PEN.wield.recover'}}</th>
          </tr>
          {{#each droppedWeapons as |weapon|}}
          <tr data-itemid="{{weapon._id}}">
            <td>{{weapon.name}}</td>
            <td>{{weapon.system.quantity}}</td>
            <td><button type="button" class="stance-btn" data-action="wieldStance" data-wield="{{weapon.pickUpStance}}" {{#if (gt weapon.system.quantity 1)}}data-tooltip="{{localize 'PEN.wield.drawHint'}}"{{/if}}>{{localize 'PEN.wield.pickUp'}}</button></td>
            <td><button type="button" class="stance-btn" data-action="wieldStance" data-wield="carried">{{localize 'PEN.wield.recover'}}</button></td>
          </tr>
          {{/each}}
        </tbody>
    </table>
    {{/if}}

    <h2>{{localize 'TYPES.Item.gear'}}</h2>
    <table>
        <tbody>
          <tr>
              <th>{{localize 'PEN.name'}}</th>
              <th>{{localize 'PEN.description'}}</th>
          </tr>
          {{#each gears as |gear key|}}
          <tr>
            <td>{{gear.name}}</td>
            <td>{{gear.system.cleanDesc}}</td>
          </tr>
          {{/each}}
        </tbody>
    </table>

</section>
