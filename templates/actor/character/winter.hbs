<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="winter">
  <h2>{{localize 'PEN.winterPhase'}}</h2>
  {{#if isIndividualWinter}}
    <p class="bold">{{localize 'PEN.individualWinterActive' year=winterYear}}</p>
    <p>{{localize 'PEN.individualWinterGlory' year=winterYear glory=system.winterGlory}}</p>
  {{/if}}
  <p>{{localize 'PEN.winterPhaseSteps'}}</p>
  <ul class="winter-steps">
    <li>{{localize 'PEN.soloScenarios'}} {{localize 'PEN.manual'}}</li>
    <li>{{localize 'PEN.personalEvents'}} {{localize 'PEN.manual'}}</li>
    <li><a class="bold" data-action="xpChecks">{{localize 'PEN.xpRoll'}}</a>
      {{#unless system.status.xp}}<i class="fas fa-check" data-tooltip="{{localize 'PEN.completed'}}"></i>{{/unless}}
    </li>
    <li><a class="bold" data-action="economic">{{localize 'PEN.economicCirc'}}</a>
      {{#unless system.status.economic}}<i class="fas fa-check" data-tooltip="{{localize 'PEN.completed'}}"></i>{{/unless}}
    </li>
    <li><a class="bold" data-action="aging">{{localize 'PEN.aging'}}</a>
      {{#unless system.status.aging}}<i class="fas fa-check" data-tooltip="{{localize 'PEN.completed'}}"></i>{{/unless}}
    </li>
    <li><a class="bold" data-action="squireAge">{{localize 'PEN.squireMaidenRoll'}}</a>
      {{#unless system.status.squireAge}}<i class="fas fa-check" data-tooltip="{{localize 'PEN.completed'}}"></i>{{/unless}}
    </li>
    <li><a class="bold" data-action="horseSurvival">{{localize 'PEN.horseSurvival'}}</a>
      {{#unless system.status.horseSurv}}<i class="fas fa-check" data-tooltip="{{localize 'PEN.completed'}}"></i>{{/unless}}
    </li>
    <li>{{localize 'PEN.training'}}
      {{#unless system.status.train}}<i class="fas fa-check" data-tooltip="{{localize 'PEN.completed'}}"></i>{{/unless}}
      <ul>
        <li><a class="bold" data-action="trainTrait">{{localize 'PEN.traitTrain'}}</a></li>
        <li><a class="bold" data-action="trainPassion">{{localize 'PEN.prestigePassion'}}</a></li>
        {{#if (lt system.age 35)}}
          <li><a class="bold" data-action="trainSingle">{{localize 'PEN.characteristicTrain'}}</a></li>
        {{/if}}
        <li><a class="bold" data-action="trainMultiple">{{localize 'PEN.skillTrain'}}</a></li>
      </ul>
    </li>
    <li>{{localize 'PEN.tallyGlory'}} <i class="fas fa-check" data-tooltip="{{localize 'PEN.completed'}}"></i></li>
    <li>{{localize 'PEN.prestigeAward'}} ({{system.gloryPrestige}})
      {{#if (eq system.gloryPrestige 0)}}<i class="fas fa-check" data-tooltip="{{localize 'PEN.completed'}}"></i>{{/if}}
      <ul>
        <li><a class="bold" data-action="prestigeTrait">{{localize 'PEN.prestigeTrait'}}</a></li>
        <li><a class="bold" data-action="prestigeCheck">{{localize 'PEN.prestigeCharacteristic'}}</a></li>
        <li><a class="bold" data-action="prestigeSkill">{{localize 'PEN.prestigeSkill'}}</a></li>
        <li><a class="bold" data-action="prestigePassion">{{localize 'PEN.prestigePassion'}}</a></li>
        <li>{{localize 'PEN.prestigeChildren'}}</li>
      </ul>
      {{#if isGM}}
        {{#unless isLocked}}
          <label class="bold"><span>{{localize 'PEN.prestigeSpent'}}:</span><input name="system.prestige" type="number" value="{{system.prestige}}"/></label>
        {{/unless}}
      {{/if}}
    </li>
    <li><a class="bold" data-action="familyRoll">{{localize 'PEN.familyRolls'}}</a>
      {{#unless system.status.familyRoll}}<i class="fas fa-check" data-tooltip="{{localize 'PEN.completed'}}"></i>{{/unless}}
    </li>
  </ul>
</section>
