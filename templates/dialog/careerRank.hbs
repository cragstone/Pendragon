<section class="Pendragon" id="career-rank">

      <div class="flexrow stat-name">
        <label style="flex: 0 0 150px;">{{localize "PEN.level"}}</label>
          <div class="centre">{{level}}</div>
      </div>
      <br>

      <div class="flexrow stat-name">
        <label style="flex: 0 0 150px;">{{localize "PEN.title"}}</label>
          <input data-handle-change class="centre" type="text" value="{{formData.title}}" name="title">
      </div>
      <br>

      <div class="flexrow stat-name">
        <label style="flex: 0 0 150px;">{{localize "PEN.description"}}</label>
        <textarea class="stat-name" style="min-height: 100px;" data-handle-change type="text" value="{{formData.description}}" name="description"></textarea>
      </div>
      <br>

      <div class="stat-name bold">{{localize "PEN.career.promotionRequirements"}}</div>
      <div class="flexrow stat-name">
        <label style="flex: 0 0 150px;">{{localize "PEN.age"}}</label>
          <input data-handle-change class="centre" type="text" value="{{formData.ageTest}}" name="ageTest">
      </div>
      <br>

      <div class="flexrow stat-name">
        <label style="flex: 0 0 150px;">{{localize "PEN.minYears"}}</label>
          <input data-handle-change class="centre" type="text" value="{{formData.minYears}}" name="minYears">
      </div>
      <br>

      <div class="flexrow stat-name">
        <label style="flex: 0 0 150px;">{{ localize 'PEN.special' }}</label>
        <select data-handle-change class="centre" value="{{formData.special}}" name="special">
          {{selectOptions specials selected=formData.special}}
        </select>
      </div>
      <br>

      <div class="flexrow stat-name">
        <label style="flex: 0 0 150px;">{{localize "PEN.career.noPromotion"}}</label>
        <input data-handle-change class="centre" type="checkbox" {{checked formData.noPromotion}} name="noPromotion">
      </div>
      <br>

      <div class="stat-name bold">{{localize "PEN.career.marriage"}}</div>
      <div class="flexrow stat-name">
        <label style="flex: 0 0 150px;">{{localize "PEN.career.marriageChance"}}</label>
          <input data-handle-change class="centre" type="number" value="{{formData.marriage}}" name="marriage">
      </div>
      <br>

      <div class="flexrow stat-name">
        <label style="flex: 0 0 150px;">{{localize "PEN.career.marriagePromotes"}}</label>
        <input data-handle-change class="centre" type="checkbox" {{checked formData.marriagePromotes}} name="marriagePromotes">
      </div>
      <br>

  </section>
